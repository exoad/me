#!/usr/bin/env bash
# Deploy photo updates end-to-end:
#   1. Process ~/Pictures/Gallery Picks into web variants + manifest
#   2. Upload any variants the exoad-photos R2 bucket does not have yet
#      (served at https://photos.exoad.net)
#   3. Commit the updated manifest here and push, which triggers the
#      Cloudflare Pages deploy
#
# Full-res originals never leave this machine — only the webp variants are
# uploaded. Run with --dry-run to process and see what would change without
# uploading or pushing anything. Pass --force to re-upload every variant (only
# needed if a photo was re-processed under the same id).
#
# Cost: uploads are R2 Class A operations (1M free a month); this sends only
# what is missing, so a normal run is three writes per new photo plus one
# listing call per 1000 objects.
#
# Requires the Cloudflare CLI (`cf`), logged in to the account that owns the
# bucket.

set -euo pipefail
cd "$(dirname "$0")"

PICKS_DIR="$HOME/Pictures/Gallery Picks"
STAGING_DIR=".photo-staging"
BUCKET="exoad-photos"

DRY_RUN=0
FORCE=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --force) FORCE=1 ;;
  esac
done

if [[ ! -d "$PICKS_DIR" ]] || ! ls "$PICKS_DIR"/*.[jJ][pP]*[gG] >/dev/null 2>&1; then
  echo "error: no JPEGs found in $PICKS_DIR" >&2
  exit 1
fi

echo "==> Processing $(ls "$PICKS_DIR"/*.[jJ][pP]*[gG] | wc -l | tr -d ' ') photos from Gallery Picks"
node scripts/process-photos.mjs "$PICKS_DIR" "$STAGING_DIR"

echo "==> Listing what $BUCKET already holds"
existing="$(mktemp)"
trap 'rm -f "$existing"' EXIT
if [[ $FORCE -eq 0 ]]; then
  cursor=""
  while :; do
    args=(r2 objects list --bucket-name "$BUCKET" --prefix gallery/ --per-page 1000)
    [[ -n "$cursor" ]] && args+=(--cursor "$cursor")
    page="$(cf "${args[@]}" 2>&1)"
    printf '%s' "$page" | node -e '
      let t = require("fs").readFileSync(0, "utf8");
      const i = t.indexOf("[");
      if (i >= 0) for (const o of JSON.parse(t.slice(i))) console.log(o.key);
    ' >> "$existing"
    cursor="$(printf '%s' "$page" | node -e '
      const t = require("fs").readFileSync(0, "utf8");
      const m = t.match(/result_info: (\{.*\})/);
      const info = m ? JSON.parse(m[1]) : {};
      process.stdout.write(info.is_truncated && info.cursor ? info.cursor : "");
    ')"
    [[ -z "$cursor" ]] && break
  done
fi

uploads=0
while IFS= read -r file; do
  key="gallery/${file#"$STAGING_DIR/gallery/"}"
  if grep -qxF "$key" "$existing"; then continue; fi
  uploads=$((uploads + 1))
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "    [dry-run] would upload $key"
  else
    cf r2 objects put "$key" --bucket-name "$BUCKET" --file "$file" --content-type image/webp >/dev/null
    echo "    uploaded $key"
  fi
done < <(find "$STAGING_DIR/gallery/thumb" "$STAGING_DIR/gallery/large" "$STAGING_DIR/gallery/xl" -type f -name '*.webp' | sort)
echo "==> $uploads variant(s) $([[ $DRY_RUN -eq 1 ]] && echo 'to upload' || echo 'uploaded')"

if git status --porcelain src/data/gallery.json | grep -q .; then
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "==> [dry-run] Would commit and push manifest:"
    git diff --stat src/data/gallery.json
  else
    echo "==> Committing manifest and deploying site"
    git add src/data/gallery.json
    git commit -m "Update photo gallery"
    git push
  fi
else
  echo "==> Manifest unchanged; nothing to deploy"
fi

echo "==> Done (re-run 'npm run og' if the newest photos changed, to refresh the link card)"
