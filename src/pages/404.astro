---
import Base from "../layouts/Base.astro";
---
<Base title="Not found | exoad" description="No page at this address.">
<main>
    <h1>404</h1>
    <p>No page at this address.</p>
    <p><a href="/">exoad.net</a> · <a href="/photos">photos</a></p>
</main>
</Base>

<style is:global>
html { background: #000; color: #fff; }
body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 16px;
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
main { display: grid; gap: 0.5rem; text-align: center; }
h1 { margin: 0; font-size: clamp(3rem, 12vw, 6rem); letter-spacing: -0.05em; line-height: 1; }
p { margin: 0; color: #8f8f8f; }
a { color: #fff; text-decoration: underline 1px #3d3d3d; text-underline-offset: 0.22em; }
a:hover, a:focus-visible { text-decoration-color: #fff; }
:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
</style>
