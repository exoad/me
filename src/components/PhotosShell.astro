---
/**
 * Everything the gallery routes share: the document, the black landing veil,
 * and the gallery itself, rendered here at build time and hydrated in the
 * browser.
 */
import Base from "../layouts/Base.astro";
import Gallery from "./Gallery.tsx";

interface Props {
    title: string;
    description: string;
    path: string;
}
const { title, description, path } = Astro.props;
---
<Base title={title} description={description}>
    <Fragment slot="head">
        <!-- The gallery lands out of black. The veil paints on the first frame,
             before any stylesheet or script resolves, and the gallery lifts it
             once its grid has painted. -->
        <style is:inline>
            html, body { margin: 0; background: #000; }
            #veil { display: none; }
            html.is-photos-landing #veil {
                display: block; position: fixed; inset: 0; background: #000;
                z-index: 9999; pointer-events: none; opacity: 1;
            }
            html.is-photos-landing #veil.is-lifted {
                opacity: 0;
                /* An opacity fade with no movement, so it is kept under reduced motion. */
                transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1) !important;
            }
            /* A single square, turning a quarter-notch at a time while the grid loads. */
            html.is-photos-landing #veil-mark {
                position: absolute; top: 50%; left: 50%; width: 13px; height: 13px;
                margin: -7px 0 0 -7px; border: 1px solid #6a6a6a;
                animation: veil-turn 1.8s ease-in-out infinite;
            }
            @keyframes veil-turn {
                0% { transform: rotate(0deg); }
                35%, 60% { transform: rotate(45deg); }
                95%, 100% { transform: rotate(90deg); }
            }
            /* To and from the home page: a short dissolve through black. The
               veil is already down in the frame the transition captures, so
               the page arrives black and the veil lifts as it always does. */
            @media (prefers-reduced-motion: no-preference) {
                @view-transition { navigation: auto; }
                ::view-transition { background: #000; }
                ::view-transition-old(root) { animation: vt-out 0.18s ease-in both; mix-blend-mode: normal; }
                ::view-transition-new(root) { animation: vt-in 0.3s ease-out 0.16s both; mix-blend-mode: normal; }
                @keyframes vt-out { to { opacity: 0; } }
                @keyframes vt-in { from { opacity: 0; } }
            }
        </style>
        <script is:inline>
            document.documentElement.classList.add("is-photos-landing");
            // Never strand the page behind an opaque veil if the gallery fails to boot.
            setTimeout(function () {
                var veil = document.getElementById("veil");
                if (veil) veil.classList.add("is-lifted");
            }, 4000);
            // Back from another page, the browser restores this one as it was
            // left, veil already lifted. Drop it and lift it again so returning
            // to the gallery still lands out of black.
            addEventListener("pageshow", function (e) {
                if (!e.persisted) return;
                var veil = document.getElementById("veil");
                if (!veil) return;
                veil.style.transition = "none";
                veil.classList.remove("is-lifted");
                void veil.offsetWidth;
                veil.style.transition = "";
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () { veil.classList.add("is-lifted"); });
                });
            });
        </script>
    </Fragment>
    <!-- Without JavaScript nothing lifts the veil or fades the photographs in. -->
    <noscript><style is:inline>html.is-photos-landing #veil { display: none; } .ph-photo { opacity: 1 !important; } .ph-blur { display: none; }</style></noscript>
    <div id="veil"><span id="veil-mark"></span></div>
    <Gallery client:load initialPath={path} />
</Base>
